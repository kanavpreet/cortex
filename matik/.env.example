# ==============================================================================
# Matik Environment Configuration (Local Development)
# ==============================================================================

# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ==============================================================================
# This file contains environment variables for local development setup. Docker compose will update the local-config YAML files with these values.
# ===============================================================================


ENVIRONMENT=local
LOG_LEVEL=INFO
AWS_REGION=us-east-1
# Local development only: placeholder credentials and endpoint for LocalStack
# In production, services use IAM roles / instance profiles and real AWS endpoints
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# ------------------------------------------------------------------------------
# MySQL Database Configuration (Local Development)
# ------------------------------------------------------------------------------
# For local development, we use traditional username/password authentication
# In Kubernetes environments, IAM authentication is used instead
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=matik_user
MYSQL_PASSWORD=matik_password
MYSQL_DATABASE=matik
MYSQL_MAX_OPEN_CONNS=100
MYSQL_MAX_IDLE_CONNS=50
MYSQL_CONN_MAX_IDLE_TIME_MINUTES=5

# ------------------------------------------------------------------------------
# Catalog Service Configuration
# ------------------------------------------------------------------------------
API_PORT=8080
# Phase 1c shared secret for service-to-service request signing (see
# common/utils/service_auth.py). Leave blank to disable signing locally.
API_SERVICE_SECRET=

# ------------------------------------------------------------------------------
# Historian Service Configuration
# ------------------------------------------------------------------------------
HISTORIAN_PORT=8082

# Incident.io
HISTORIAN_INCIDENTIO_API_KEY=your-incidentio-api-key-here
HISTORIAN_INCIDENTIO_BASE_URL=https://api.incident.io
HISTORIAN_INCIDENTIO_PAGE_SIZE=100
HISTORIAN_INCIDENTIO_MAX_RETRIES=3
HISTORIAN_INCIDENTIO_TIMEOUT=30
HISTORIAN_INCIDENTIO_START_DATE="2025-01-01"
HISTORIAN_INCIDENTIO_LOOKBACK_DAYS=1
HISTORIAN_INCIDENTIO_WRITE_BATCH_SIZE=50
HISTORIAN_INCIDENTIO_CONSUMER_TIMEOUT_SECONDS=60
HISTORIAN_INCIDENTIO_MAX_CONCURRENT_LLM_CALLS=10
HISTORIAN_INCIDENTIO_ROOT_CAUSE_PROMPT="You are an an expert in extracting the root cause from an incident description. Your task is to process incident descriptions with the following requirements: 1. PII Scrubbing: Remove or redact any Personally Identifiable Information (PII) including email addresses, phone numbers, names of individuals (unless they are public figures), IP addresses, personal addresses, social security numbers or employee IDs, and any other sensitive personal data. 2. Root Cause Summary Generation: Create a concise, human-readable, easy to understand, summary that captures the root cause of the incident. The summary must be written in a single paragraph, use plain text only with no markdown, no bullet points, and no special formatting, and be clear and very concise without losing key information. 3. Focus on the root cause and effect only, not the resolution 4. Output Format: Return your response ONLY as a plain string."
HISTORIAN_INCIDENTIO_DESCRIPTION_PROMPT="You are an incident resolution summarizer. Your task is to process incident descriptions with the following requirements: 1. PII Scrubbing: Remove or redact any Personally Identifiable Information (PII) including email addresses, phone numbers, names of individuals (unless they are public figures), IP addresses, personal addresses, social security numbers or employee IDs, and any other sensitive personal data. 2. Summary Generation: Create a concise, human-readable, easy to understand, resolution summary that captures the resolution described. The summary must be written in a single paragraph, use plain text only with no markdown, no bullet points, and no special formatting, and be clear and very concise without losing key information. 3. You will be given two paragraphs, an overall summary of the incident and the resolution. Use both to extract a well defined resolution summary. Make sure to only focus on the resolution. 3. Output Format: Return your response ONLY as a plain string."

# Greenroom
HISTORIAN_GREENROOM_HOST=developers.a.musta.ch
HISTORIAN_GREENROOM_API_TOKEN=your-greenroom-api-token-here

# Jira
HISTORIAN_JIRA_BASE_URL=https://jirarest.airbnb.biz
HISTORIAN_JIRA_USERNAME=your-jira-username-here
HISTORIAN_JIRA_PASSWORD=your-jira-password-here
HISTORIAN_JIRA_TCMR_JQL_ENABLED=true  # Set to true to enable TCMR JQL processing
HISTORIAN_JIRA_TCMR_JQL="project = TCMR AND [REPLACE BATCH DATES] ORDER BY created DESC"
HISTORIAN_JIRA_OPERATIONAL_JQL_ENABLED=false  # Set to true to enable operational JQL processing
HISTORIAN_JIRA_OPERATIONAL_JQL="project = 'AirSupport Service Desk' AND issuetype = Alert AND [REPLACE BATCH DATES] ORDER BY created DESC" # Example: Replace 'OPS' with your operational tickets project key
HISTORIAN_JIRA_PAGINATION_MAX_RESULTS=200
HISTORIAN_JIRA_LOOKBACK_DAYS=185  # Number of days to look back once caught up to present (default: 185 days)
HISTORIAN_JIRA_LLM_DESCRIPTION_PROMPT="You are a Jira Issue Description Analyzer. Your task is to process Jira issue descriptions with the following requirements: 1. PII Scrubbing: Remove or redact any Personally Identifiable Information (PII) including email addresses, phone numbers, names of individuals (unless they are public figures), IP addresses, personal addresses, social security numbers or employee IDs, and any other sensitive personal data. 2. Summary Generation: Create a concise, human-readable summary that captures the main purpose of the Jira issue and highlights the key problem, request, or change described. The summary must be written in a single paragraph, use plain text only with no markdown, no bullet points, and no special formatting, and be clear and to the point. 3. Output Format: Return your response ONLY as a plain string."
HISTORIAN_JIRA_LLM_COMMENTS_PROMPT="You are a Jira Issue Description Analyzer. Your task is to process Jira issue descriptions with the following requirements: 1. PII Scrubbing: Remove or redact any Personally Identifiable Information (PII) including email addresses, phone numbers, names of individuals (unless they are public figures), IP addresses, personal addresses, social security numbers or employee IDs, and any other sensitive personal data. 2. Summary Generation: Create a concise, human-readable summary that captures the main purpose of the Jira issue and highlights the key problem, request, or change described. The summary must be written in a single paragraph, use plain text only with no markdown, no bullet points, and no special formatting, and be clear and to the point. 3. Output Format: Return your response ONLY as a plain string."
HISTORIAN_JIRA_CLIENT_TIMEOUT=60
HISTORIAN_JIRA_CATCH_UP_MIN_GAP_MINUTES=10  # Minimum gap in minutes to trigger a catch-up batch instead of switching to lookback

# ------------------------------------------------------------------------------
# Chronicler Service Configuration
# Chronicler is a Kafka consumer (no inbound HTTP).
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka-prod-a.kafka-prod-a:9092
CHRONICLER_GITHUB_WEBHOOK_SECRET=
CHRONICLER_INCIDENTIO_WEBHOOK_SECRET=
CHRONICLER_GENERIC_WEBHOOK_SECRET=
CHRONICLER_SCRIBE_QUEUE_URL=http://localstack:4566/000000000000/matik-scribe-hp
CHRONICLER_SCRIBE_QUEUE_REGION=us-east-1
CHRONICLER_ENRICHER_QUEUE_URL=http://localstack:4566/000000000000/matik-enricher
CHRONICLER_ENRICHER_QUEUE_REGION=us-east-1

# ------------------------------------------------------------------------------
# Enigmatologist Service Configuration
# ------------------------------------------------------------------------------
ENIGMATOLOGIST_PORT=8084
ENIGMATOLOGIST_QUEUE_URL=http://localstack:4566/000000000000/matik-enigmatologist

# ------------------------------------------------------------------------------
# Enricher Service Configuration
# ------------------------------------------------------------------------------
ENRICHER_PORT=8085
ENRICHER_QUEUE_URL=http://localstack:4566/000000000000/matik-enricher
ENRICHER_DLQ_URL=http://localstack:4566/000000000000/matik-enricher-dlq
SCRIBE_LLM_QUEUE_URL=http://localstack:4566/000000000000/matik-scribe-llm

# Facade mock mode — false for production, set to true in .env.local for LocalStack testing
FACADE_MOCK_MODE=false

# Facade default model — used by IncidentIO and JIRA handlers (which pass model=None
# to the Facade client, falling back to this value). GHE messages carry their own
# facade_model field instead. Override to test 400 errors with an invalid model name.
# NOTE: envsubst does not support ${VAR:-default} syntax, so this variable MUST be set.
FACADE_DEFAULT_MODEL=matik-sandbox-gpt-5

# ------------------------------------------------------------------------------
# Biztech GHE Service Configuration
# ------------------------------------------------------------------------------
GHE_BASE_URL="https://github.airbnb.biz"
GHE_API_PATH="/api/v3"
GHE_UPLOAD_PATH="/api/uploads"
GHE_CLIENT_ID="Iv1.3f7189467b4e23bc"
GHE_INSTALLATION_ID="53"
GHE_APP_ID="51"
GHE_PR_SUMMARY_PROMPT="You are a Pull Request Description Analyzer. Your task is to process pull request descriptions with the following requirements: 1. PII Scrubbing: Remove or redact any Personally Identifiable Information (PII) including: Email addresses, Phone numbers, Names of individuals (unless they are public figures), IP addresses, Personal addresses, Social security numbers or employee IDs, Any other sensitive personal data. 2. Summary Generation: Create a concise, human-readable summary that: Captures the main purpose of the pull request, Highlights key changes or features, Is written in a single paragraph, Uses plain text only (no markdown, no bullet points, no special formatting), Is clear and to the point. 3. Output Format: Return your response ONLY as a plain string."
GHE_PRIVATE_KEY_FILE_NAME="ghe_private_key.pem"
GHE_PRIVATE_KEY="<defined in bagpiper in prod/dev/stage. Use this when running locally>"
GHE_FACADE_MODEL="matik-sandbox-gpt-5"

# ------------------------------------------------------------------------------
# LLM Fusion Hub configuration defaults (local development only)
# ------------------------------------------------------------------------------
# Get your token by running: airtool install iap-auth && iap-auth https://llm-fusion-hub.a.musta.ch
# To automatically update the token: sed -i '' "s|^IAP_TOKEN=.*|IAP_TOKEN=$(iap-auth https://llm-fusion-hub.a.musta.ch)|" .env.local
IAP_TOKEN=your-iap-token-here

# ------------------------------------------------------------------------------
# Greenroom/Backstage authentication (local development only)
# ------------------------------------------------------------------------------
# Get your token by running: iap-auth https://developers.a.musta.ch
IAP_TOKEN_GREENROOM=your-greenroom-iap-token-here

# ------------------------------------------------------------------------------
# Artifactory Configuration
# ------------------------------------------------------------------------------
ARTIFACTORY_BASE_URL="https://artifactory.airbnb.biz/artifactory"
# This is optional. Some artifactory endpoints don't require an API Key to download. If one is needed, reach out to SysEng.
ARTIFACTORY_API_KEY=""

# ------------------------------------------------------------------------------
# Telescope Metrics Configuration
# ------------------------------------------------------------------------------
# Set TELESCOPE_ENABLED=true to enable metrics collection
TELESCOPE_ENABLED="true"
TELESCOPE_TENANT_ID="matik"
TELESCOPE_PUSH_INTERVAL_SECONDS="15"
# Base URL only - /v1/metrics path is appended automatically
TELESCOPE_OTEL_ENDPOINT="http://otel-collector:4318"

# ------------------------------------------------------------------------------
# LLM Tracing Configuration (GenAI Studio / Braintrust)
# ------------------------------------------------------------------------------
# Set LLM_TRACING_ENABLED=true to trace production LLM calls (Facade + Bedrock)
# to Braintrust. Requires IAP_TOKEN. LLM_TRACING_CAPTURE_CONTENT logs prompt/
# response content (can carry PII) on spans, for both providers.
LLM_TRACING_ENABLED="false"
LLM_TRACING_BRAINTRUST_PROJECT_ID="83609831-3743-484e-ab37-172432a384ab"
LLM_TRACING_CAPTURE_CONTENT="true"


# Matik MCP Configuration
# ------------------------------------------------------------------------------
MATIK_API_ENDPOINT=http://api:8080



# Scribe Service Configuration
# ------------------------------------------------------------------------------
SCRIBE_HIGH_PRIORITY_QUEUE_URL=http://localstack:4566/000000000000/matik-scribe-high-priority
SCRIBE_HIGH_PRIORITY_DLQ_URL=http://localstack:4566/000000000000/matik-scribe-high-priority-dlq
SCRIBE_MEDIUM_PRIORITY_QUEUE_URL=http://localstack:4566/000000000000/matik-scribe-medium-priority
SCRIBE_MEDIUM_PRIORITY_DLQ_URL=http://localstack:4566/000000000000/matik-scribe-medium-priority-dlq
SCRIBE_LOW_PRIORITY_QUEUE_URL=http://localstack:4566/000000000000/matik-scribe-low-priority
SCRIBE_LOW_PRIORITY_DLQ_URL=http://localstack:4566/000000000000/matik-scribe-low-priority-dlq
SCRIBE_ENRICHMENT_BASE_NOT_FOUND_DELAY=300


# Root Cause Coverage Audit Configuration
# ------------------------------------------------------------------------------
ROOT_CAUSE_AUDIT_SPREADSHEET_ID=your-spreadsheet-id-here
ROOT_CAUSE_AUDIT_WORKSHEET_NAME=incidents
ROOT_CAUSE_AUDIT_CORRELATIONS_WORKSHEET_NAME=correlations
# Full contents of the service account's JSON key (secret-lair:
# root_cause_audit.sheets_service_account in prod/staging/sandbox)
ROOT_CAUSE_AUDIT_SHEETS_SERVICE_ACCOUNT_JSON=your-service-account-json-here
ROOT_CAUSE_AUDIT_GROUND_TRUTH_EXTRACTION_PROMPT=your-ground-truth-extraction-prompt-here
